{
  "name": "webgl2-top",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "トップページ(レンズ格子ポートフォリオ)のソース。ビルド成果物はリポジトリルートへ出力しコミットする。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && rm -rf ../assets/top && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.{ts,glsl,css}\" \"test/**/*.ts\" index.html"
  },
  "dependencies": {
    "lil-gui": "^0.20.0",
    "stats.js": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.1.2",
    "@types/stats.js": "^0.17.4",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
